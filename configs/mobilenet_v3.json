{
  "model": "mobilenet_v3",
  "data": {
    "image_size": 224,
    "batch_size": 32,
    "num_workers": 4,
    "seed": 42
  },
 "training": {
    "epochs": 8,
    "learning_rate": 0.0001,
    "optimizer": "AdamW",
    "weight_decay": 0.0001,
    "pretrained": true,
    "early_stopping": {
      "enabled": true,
      "patience": 2,
      "monitor": "val_f1",
      "mode": "max"
    }
  },
  "wandb": {
    "enabled": true,
    "entity": "sesac08",
    "project": "skina",
    "run_name": "mobilenet_v3_baseline_v2"
  },
  "inference": {
    "top_k": 3,
    "checkpoint": "outputs/models/mobilenet_v3_best.pth"
  }
}
