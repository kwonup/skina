# 프로젝트 루트의 원본 및 전처리 데이터만 제외한다.
# src/data/는 Python 소스 코드이므로 Git으로 관리한다.
/data/

# 큰 모델 파일만 제외하고 작은 결과 파일과 plot은 추적 가능
outputs/models/*
!outputs/models/.gitkeep

# 실험 로그와 Python cache
wandb/
__pycache__/
*.pyc
.ipynb_checkpoints/

# 로컬 환경과 비밀값
.venv/
venv/
.env
.DS_Store

